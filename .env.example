## ============================================================
## Plantilla de variables de entorno para Nodo
## Copiar a .env y completar los valores antes de correr.
##
## DEV:   docker compose up
## PROD:  SUPERADMIN_PASSWORD='miClave' bash scripts/deploy.sh
## ============================================================

# --- Entorno ---
# Valores válidos: development | production
ENVIRONMENT=development

# --- Base de datos ---
POSTGRES_USER=nodo_admin
POSTGRES_PASSWORD=replace_with_secure_password
POSTGRES_DB=nodo_db
DATABASE_URL=postgresql+asyncpg://nodo_admin:replace_with_secure_password@db:5432/nodo_db

# --- Seguridad / Tokens ---
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_32_byte_hex_string
RESET_PASSWORD_SECRET=replace_with_secret_string
VERIFICATION_TOKEN_SECRET=replace_with_secret_string

# Hash bcrypt del superadmin. Dejarlo en __PENDING_BCRYPT_HASH__ para que
# deploy.sh lo genere automáticamente la primera vez.
SUPERADMIN_PASSWORD_HASH=__PENDING_BCRYPT_HASH__

# --- URLs (ajustar según entorno) ---
# DEV:
BASE_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# PROD (reemplazar con el dominio real):
# BASE_URL=https://hellonodo.com
# BACKEND_URL=https://hellonodo.com
# FRONTEND_URL=https://hellonodo.com
# CORS_ORIGINS=https://hellonodo.com

# --- Cookies ---
# DEV: False (no hay HTTPS local)
# PROD: True (OBLIGATORIO detrás de HTTPS/Cloudflare)
COOKIE_SECURE=False

# --- Push Notifications (VAPID) ---
# Generar con: python -c "from py_vapid import Vapid; v=Vapid(); v.generate_keys(); print(v.public_key, v.private_key)"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY_PEM=
VAPID_CONTACT_EMAIL=admin@nodo.com

# --- Google OAuth (opcional) ---
GOOGLE_CLIENT_SECRET=

# --- Amazon Relay (opcional) ---
# URL del relay residencial (ver relay/README.md). Dejar vacío para scraping directo.
AMAZON_RELAY_URL=
AMAZON_RELAY_TOKEN=
