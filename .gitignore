# Entorno y Secretos
.env
.env.*
!.env.example
# Config de build del frontend (no secreta, necesaria para compilar en prod)
!frontend/.env.production
*.pem
*.key
superadmin_secrets.json

# Python / FastAPI
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
backend/.venv/

# Node / React (Frontend)
frontend/node_modules/
frontend/dist/
frontend/.eslintcache
npm-debug.log

# Docker y Sistema Operativo
.DS_Store
Thumbs.db

# Screenshots de pruebas / Playwright
*.png
*.jpg
*.jpeg
# Pero los assets de frontend/public sí van al repo
!frontend/public/*.png
!frontend/public/*.jpg
!frontend/public/*.jpeg
.playwright-mcp/

# Archivos accidentales
=*

# Respaldo del build vivo (rollback manual, no va al repo)
frontend/dist.bak/
