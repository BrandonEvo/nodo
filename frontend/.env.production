# URL base de la API en producción. Relativa: el frontend se sirve en el mismo
# origen que la API (nginx proxea /api al backend), así funciona con cualquier
# dominio sin recompilar. Vite la inyecta en import.meta.env.VITE_API_URL al
# correr `npm run build`. Sin esto, el botón de Google OAuth cae a localhost.
VITE_API_URL=/api
